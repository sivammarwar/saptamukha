{
  "rewrites": [
    {
      "source": "/api/face/analyze-batch",
      "destination": "/api/face/analyze-batch"
    },
    {
      "source": "/api/face/analyze",
      "destination": "/api/face/analyze"
    },
    {
      "source": "/api/face/embed",
      "destination": "/api/face/embed"
    },
    {
      "source": "/api/face/health",
      "destination": "/api/face/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, X-API-Key, Authorization"
        }
      ]
    }
  ]
}
